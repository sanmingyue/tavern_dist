{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "default": {},
      "type": "object",
      "properties": {
        "当前日期": {
          "default": "8月1日",
          "type": "string"
        },
        "当前时间": {
          "default": "10:00",
          "type": "string"
        },
        "当前地点": {
          "default": "家门口",
          "type": "string"
        },
        "天气": {
          "default": "晴",
          "type": "string"
        }
      }
    },
    "洛潮汐": {
      "default": {},
      "type": "object",
      "properties": {
        "表情": {
          "default": "微笑",
          "type": "string",
          "enum": [
            "微笑",
            "开心",
            "大笑",
            "害羞",
            "平静",
            "思考",
            "惊讶",
            "疑惑",
            "温柔",
            "思念",
            "撒娇",
            "调皮",
            "心动",
            "深情凝视",
            "依赖",
            "轻伤感",
            "难过",
            "哭泣",
            "痛哭",
            "心痛",
            "强忍",
            "释然",
            "疲倦",
            "虚弱",
            "气短",
            "晕眩",
            "病中微笑",
            "沉睡",
            "被风吹",
            "看海",
            "看烟花",
            "雨中",
            "夕阳下",
            "月光下",
            "吃东西",
            "画画中",
            "浴衣",
            "举起相机",
            "最后的笑",
            "告别",
            "安详"
          ]
        }
      }
    },
    "愿望清单": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "愿望编号1-10"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "_名称": {
            "type": "string"
          },
          "状态": {
            "default": "未开始",
            "type": "string",
            "enum": [
              "未开始",
              "进行中",
              "已完成"
            ]
          },
          "完成日期": {
            "type": "string"
          }
        },
        "required": [
          "_名称"
        ]
      }
    },
    "成就": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "成就ID，格式: 前缀+三位编号，如 RE001、DA042、FI001"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "解锁日期": {
            "type": "string"
          }
        }
      }
    }
  }
}