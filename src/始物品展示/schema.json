{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "当前房间": {
      "default": "第一层·起始之间",
      "type": "string"
    },
    "主角": {
      "default": {},
      "type": "object",
      "properties": {
        "持有物品": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      }
    },
    "场景物品": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "interactions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "name",
        "description"
      ]
    }
  }
}