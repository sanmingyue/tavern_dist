{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "交易次数": {
      "type": "number"
    },
    "本周交易次数": {
      "type": "number"
    },
    "奥妮安存款": {
      "default": 500,
      "type": "number"
    },
    "当前场景": {
      "default": "学校天台",
      "type": "string",
      "enum": [
        "学校教室",
        "学校天台",
        "学校走廊",
        "学校食堂",
        "学校厕所",
        "学校体育馆",
        "学校图书馆",
        "{{user}}家客厅",
        "{{user}}家卧室",
        "{{user}}家浴室",
        "{{user}}家阳台",
        "便利店",
        "奥妮安家",
        "地铁上",
        "公园长椅",
        "电影院",
        "商场",
        "天桥下",
        "小巷子",
        "街道"
      ]
    },
    "星期": {
      "default": "星期三",
      "type": "string",
      "enum": [
        "星期一",
        "星期二",
        "星期三",
        "星期四",
        "星期五",
        "星期六",
        "星期日"
      ]
    },
    "时间段": {
      "default": "中午",
      "type": "string",
      "enum": [
        "早晨",
        "上午",
        "中午",
        "下午",
        "傍晚",
        "晚上",
        "深夜"
      ]
    },
    "特殊事件": {
      "default": "无",
      "type": "string",
      "enum": [
        "无",
        "差点被发现",
        "体育课后",
        "雨天湿身",
        "极度缺钱"
      ]
    },
    "关系状态": {
      "default": "交易对象",
      "type": "string",
      "enum": [
        "交易对象",
        "特殊存在",
        "暧昧",
        "恋人"
      ]
    }
  }
}